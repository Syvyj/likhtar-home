        Платформна тема без ActionBar: увесь UI малює Compose, тому XML-тема лише задає
        темне тло вікна, щоб не було світлого блимання під час старту лаунчера.
    -->
    <style name="Theme.Likhtar" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/likhtar_background</item>
        <item name="android:colorBackground">@color/likhtar_background</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
