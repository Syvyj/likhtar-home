<?xml version="1.0" encoding="utf-8"?>
<!-- «Передати на приставку» до Android 10: файли в теці лаунчера, плеєру — через FileProvider.
     З Android 10 вони в загальних Download/Likhtar (MediaStore), провайдер не потрібен. -->
<paths>
    <external-files-path name="drop" path="Download/Likhtar/" />
    <files-path name="drop_internal" path="downloads/Likhtar/" />
    <!-- Образи ігор з телефона («Ігри»). -->
    <external-files-path name="roms" path="Download/ROMs/" />
    <files-path name="roms_internal" path="downloads/ROMs/" />
    <!-- Оновлення лаунчера: APK з GitHub перед встановленням (AppUpdate). -->
    <cache-path name="updates" path="updates/" />
</paths>
